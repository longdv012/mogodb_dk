      "targets": [
        {
          "datasource": { "type": "loki", "uid": "loki" },
          "expr": "sum by (level) (count_over_time({job=\"laravel\"} | logfmt | level != `` [$__interval]))",
          "legendFormat": "{{level}}",
          "refId": "A"
        },
        {
          "datasource": { "type": "loki", "uid": "loki" },
          "expr": "sum(count_over_time({job=\"laravel\"} |~ `(?i)\\.ERROR:` [$__interval]))",
